[#ftl]
<# :
@echo off
setlocal
REM ============================================================================
REM Auto-generated by STM32CubeMX from install_bat.ftl
REM Date: ${date!"N/A"}
REM ============================================================================

[#if FamilyName??]
SET "CFG_FAMILY_NAME=${FamilyName}"
[/#if]
[#if ProjectName??]
SET "CFG_PROJECT_NAME=${ProjectName}"
[/#if]
[#if timeBaseSource??]
SET "CFG_TIMEBASE_SOURCE=${timeBaseSource}"
[/#if]

SET "IP_FREERTOS=0"
SET "IP_LWIP=0"
SET "IP_USB_DEVICE=0"
SET "IP_USB_HOST=0"
SET "IP_ETH=0"
SET "IP_FATFS=0"
SET "IP_MBEDTLS=0"
SET "FREERTOS_INTERFACE=NONE"

[#list configs as dt]
[#assign usedIPs = dt.usedIPs]
[#assign peripheralParams = dt.peripheralParams]
[#assign ipList = ""]

[#list peripheralParams.entrySet() as periphEntry]
[#assign ip = periphEntry.key]
[#assign cleanIpName = ip?replace(" ", "_")?replace("-", "_")]
[#if ipList == ""][#assign ipList = cleanIpName][#else][#assign ipList = ipList + "," + cleanIpName][/#if]
SET "IP_${cleanIpName}=1"
[/#list]
SET "USED_IPS=${ipList}"

[#if peripheralParams.get("FREERTOS")??]
[#assign rtosCmsisVer = peripheralParams.get("FREERTOS").get("CMSIS_version")!""]
[#assign rtosApi = peripheralParams.get("FREERTOS").get("FreeRTOS_API")!""]
[#if rtosCmsisVer?starts_with("2")]
SET "FREERTOS_INTERFACE=CMSIS_V2"
[#elseif rtosCmsisVer?starts_with("1")]
SET "FREERTOS_INTERFACE=CMSIS_V1"
[#else]
SET "FREERTOS_INTERFACE=NATIVE"
[/#if]
[/#if]

[#list peripheralParams.entrySet() as periphEntry]
[#assign ip = periphEntry.key]
[#assign cleanIpName = ip?replace(" ", "_")?replace("-", "_")]
[#if periphEntry.value?? && periphEntry.value.entrySet()?size > 0]
REM --- ${ip} Parameters ---
[#list periphEntry.value.entrySet() as paramEntry]
[#if paramEntry.value??]
[#assign cleanKey = paramEntry.key?replace(" ", "_")?replace("(", "")?replace(")", "")?replace("-", "_")?replace(".", "_")?replace("/", "_")]
[#assign cleanVal = paramEntry.value?replace("\"", "")?replace("%", "%%")?replace("&", "^&")?replace("|", "^|")?replace("<", "^<")?replace(">", "^>")?replace("\r", "")?replace("\n", " ")]
SET "CFG_${cleanIpName}_${cleanKey}=${cleanVal}"
[/#if]
[/#list]
[/#if]
[/#list]
[/#list]

REM ============================================================================
REM Run embedded PowerShell folder comparison and sync engine
REM ============================================================================
powershell -NoProfile -ExecutionPolicy Bypass -Command "$scriptPath = '%~f0'; Invoke-Expression ([System.IO.File]::ReadAllText($scriptPath))"
exit /b %ERRORLEVEL%
#>

$ErrorActionPreference = 'Stop'
$projectDir = Split-Path -Path $scriptPath -Parent

# 1. Dynamically discover the .ioc file in the project folder
$iocFile = Get-ChildItem -Path $projectDir -Filter '*.ioc' -File -ErrorAction SilentlyContinue | Select-Object -First 1
if (-not $iocFile) {
    Write-Error "No .ioc file found in $projectDir"
    exit 1
}

Write-Host "=== Post-CubeMX Sync ($($iocFile.Name)) ===" -ForegroundColor Cyan

# 2. Resolve Firmware Package path (STM32CubeF7) dynamically from .ioc
$iocLines = Get-Content -LiteralPath $iocFile.FullName
$fwRelPath = '..\Lib\STM32CubeF7'
foreach ($line in $iocLines) {
    if ($line -match '^ProjectManager\.CustomerFirmwarePackage=(.+)$') {
        $fwRelPath = $Matches[1].Trim() -replace '\\\\', '\'
        break
    }
}
$fwDir = [System.IO.Path]::GetFullPath((Join-Path $projectDir $fwRelPath))
if (-not (Test-Path $fwDir)) {
    Write-Warning "Firmware package directory not found at: $fwDir"
    exit 0
}

# 3. Read configuration environment variables set at the top of this generated install.bat
$useFreeRTOS = ($env:IP_FREERTOS -eq '1')
$rtosInterface = $env:FREERTOS_INTERFACE
if (-not $rtosInterface) { $rtosInterface = 'NONE' }

Write-Host "Detected Configuration -> IP_FREERTOS=$($env:IP_FREERTOS), FREERTOS_INTERFACE=$rtosInterface, CMSIS_version=$($env:CFG_FREERTOS_CMSIS_version)" -ForegroundColor Cyan

# Helper function: Compare source and destination files by size & SHA-256 hash, copy only if different
function Sync-FolderFiles {
    param(
        [string]$SourceDir,
        [string]$DestDir,
        [string]$Filter = '*',
        [switch]$Recurse,
        [switch]$RemoveStale
    )
    if (-not (Test-Path $SourceDir)) { return 0 }
    if (-not (Test-Path $DestDir)) {
        New-Item -ItemType Directory -Path $DestDir -Force | Out-Null
    }
    $srcRoot = $SourceDir.TrimEnd('\', '/')
    $dstRoot = $DestDir.TrimEnd('\', '/')
    $changed = 0
    $validRel = @{}

    $srcFiles = Get-ChildItem -Path $srcRoot -Filter $Filter -File -Recurse:$Recurse
    foreach ($sf in $srcFiles) {
        $rel = $sf.FullName.Substring($srcRoot.Length + 1)
        $validRel[$rel] = $true
        $dfPath = Join-Path $dstRoot $rel
        $needCopy = $false

        if (-not (Test-Path $dfPath)) {
            $needCopy = $true
        } else {
            $df = Get-Item -LiteralPath $dfPath
            if ($sf.Length -ne $df.Length) {
                $needCopy = $true
            } else {
                $h1 = (Get-FileHash -LiteralPath $sf.FullName -Algorithm SHA256).Hash
                $h2 = (Get-FileHash -LiteralPath $dfPath -Algorithm SHA256).Hash
                if ($h1 -ne $h2) {
                    $needCopy = $true
                }
            }
        }

        if ($needCopy) {
            $parent = Split-Path -Path $dfPath -Parent
            if (-not (Test-Path $parent)) {
                New-Item -ItemType Directory -Path $parent -Force | Out-Null
            }
            Copy-Item -LiteralPath $sf.FullName -Destination $dfPath -Force
            Write-Host "  [UPDATED] $rel" -ForegroundColor Green
            $changed++
        }
    }

    if ($RemoveStale -and (Test-Path $dstRoot)) {
        $dstFiles = Get-ChildItem -Path $dstRoot -Filter $Filter -File -Recurse:$Recurse
        foreach ($df in $dstFiles) {
            $rel = $df.FullName.Substring($dstRoot.Length + 1)
            if (-not $validRel.ContainsKey($rel)) {
                Remove-Item -LiteralPath $df.FullName -Force
                Write-Host "  [REMOVED STALE] $rel" -ForegroundColor Yellow
                $changed++
            }
        }
    }
    return $changed
}

$totalChanges = 0

# ============================================================================
# 4. Source 1 (Drivers/CMSIS 6.2.0): Core Headers (Include + Include/m-profile)
# ============================================================================
$fwCmsisInc = Join-Path $fwDir 'Drivers\CMSIS\Include'
$prjCmsisInc = Join-Path $projectDir 'Drivers\CMSIS\Include'
if (Test-Path $fwCmsisInc) {
    $totalChanges += Sync-FolderFiles -SourceDir $fwCmsisInc -DestDir $prjCmsisInc -Filter '*.h' -RemoveStale
    $fwMProfile = Join-Path $fwCmsisInc 'm-profile'
    $prjMProfile = Join-Path $prjCmsisInc 'm-profile'
    if (Test-Path $fwMProfile) {
        $totalChanges += Sync-FolderFiles -SourceDir $fwMProfile -DestDir $prjMProfile -Filter '*.h' -RemoveStale
    } elseif (Test-Path $prjMProfile) {
        Remove-Item -Path $prjMProfile -Recurse -Force
        Write-Host "  [CLEANED] Removed Drivers\CMSIS\Include\m-profile (not present in Firmware Package)" -ForegroundColor Yellow
        $totalChanges++
    }
}

# ============================================================================
# 5. Source 1 (Drivers/CMSIS/RTOS2) & Source 2 (Middlewares/.../FreeRTOS)
# ============================================================================
$cprojectPath = Join-Path $projectDir '.cproject'
$prjRtos2Dir = Join-Path $projectDir 'Drivers\CMSIS\RTOS2'
$prjFreeRtosDir = Join-Path $projectDir 'Middlewares\Third_Party\FreeRTOS'

if (-not $useFreeRTOS) {
    Write-Host "FreeRTOS is DISABLED. Skipping FreeRTOS & CMSIS-RTOS2 sync." -ForegroundColor Yellow
    if (Test-Path $prjRtos2Dir) {
        Remove-Item -Path $prjRtos2Dir -Recurse -Force
        Write-Host "  [CLEANED] Removed Drivers\CMSIS\RTOS2" -ForegroundColor Yellow
    }
    if (Test-Path $cprojectPath) {
        $cpContent = Get-Content -Path $cprojectPath -Raw
        $cleanedCp = $cpContent -replace '(?m)^\s*<listOptionValue builtIn="false" value="\.\./Drivers/CMSIS/RTOS2/Include"/>\r?\n', ''
        if ($cleanedCp -ne $cpContent) {
            Set-Content -Path $cprojectPath -Value $cleanedCp -NoNewline
            Write-Host "  [CLEANED] Removed ../Drivers/CMSIS/RTOS2/Include from .cproject" -ForegroundColor Yellow
        }
    }
} else {
    $fwFreeRtosSrc = Join-Path $fwDir 'Middlewares\Third_Party\FreeRTOS\Source'
    $prjFreeRtosSrc = Join-Path $prjFreeRtosDir 'Source'

    # 5a. Sync Core FreeRTOS kernel files (Source/*.c, Source/include/*.h, portable, heap)
    if (Test-Path $fwFreeRtosSrc) {
        $totalChanges += Sync-FolderFiles -SourceDir $fwFreeRtosSrc -DestDir $prjFreeRtosSrc -Filter '*.c'
        $totalChanges += Sync-FolderFiles `
            -SourceDir (Join-Path $fwFreeRtosSrc 'include') `
            -DestDir (Join-Path $prjFreeRtosSrc 'include') `
            -Filter '*.h' -RemoveStale

        # Portable GCC ARM_CM7 files
        $prjPortDir = Join-Path $prjFreeRtosSrc 'portable\GCC\ARM_CM7\r0p1'
        $fwPortDir  = Join-Path $fwFreeRtosSrc 'portable\GCC\ARM_CM7\r0p1'
        if (Test-Path $fwPortDir) {
            $totalChanges += Sync-FolderFiles -SourceDir $fwPortDir -DestDir $prjPortDir -Filter '*' -RemoveStale
        }

        # Heap file (from CFG_FREERTOS_HEAP_NUMBER or existing heap_*.c)
        $prjMemMang = Join-Path $prjFreeRtosSrc 'portable\MemMang'
        $fwMemMang  = Join-Path $fwFreeRtosSrc 'portable\MemMang'
        if (Test-Path $fwMemMang) {
            $heapNum = $env:CFG_FREERTOS_HEAP_NUMBER
            if ($heapNum) {
                $totalChanges += Sync-FolderFiles -SourceDir $fwMemMang -DestDir $prjMemMang -Filter "heap_$heapNum.c" -RemoveStale
            } elseif (Test-Path $prjMemMang) {
                foreach ($hf in (Get-ChildItem -Path $prjMemMang -Filter 'heap_*.c' -File)) {
                    $totalChanges += Sync-FolderFiles -SourceDir $fwMemMang -DestDir $prjMemMang -Filter $hf.Name
                }
            }
        }
    }

    # 5b. Sync CMSIS-RTOS wrapper strictly according to FREERTOS_INTERFACE (CMSIS_V2 vs CMSIS_V1 vs NATIVE)
    $fwRtos2Inc  = Join-Path $fwDir 'Drivers\CMSIS\RTOS2\Include'
    $prjRtos2Inc = Join-Path $prjRtos2Dir 'Include'
    $fwCmsisV2   = Join-Path $fwFreeRtosSrc 'CMSIS_RTOS_V2'
    $prjCmsisV2  = Join-Path $prjFreeRtosSrc 'CMSIS_RTOS_V2'
    $fwCmsisV1   = Join-Path $fwFreeRtosSrc 'CMSIS_RTOS'
    $prjCmsisV1  = Join-Path $prjFreeRtosSrc 'CMSIS_RTOS'

    if ($rtosInterface -eq 'CMSIS_V2') {
        $needDriversRtos2 = (Test-Path $fwRtos2Inc) -and (-not (Test-Path (Join-Path $fwCmsisV2 'cmsis_os2.h')))
        if ($needDriversRtos2) {
            Write-Host "Syncing CMSIS_V2 (Split layout): Drivers\CMSIS\RTOS2\Include (cmsis_os2.h) + Middlewares\...\CMSIS_RTOS_V2 (cmsis_os2.c)" -ForegroundColor Cyan
            $totalChanges += Sync-FolderFiles -SourceDir $fwRtos2Inc -DestDir $prjRtos2Inc -Filter '*.h' -RemoveStale
        } else {
            Write-Host "Syncing CMSIS_V2 (Classic layout): Middlewares\...\CMSIS_RTOS_V2" -ForegroundColor Cyan
            if (Test-Path $prjRtos2Dir) {
                Remove-Item -Path $prjRtos2Dir -Recurse -Force
                $totalChanges++
            }
        }
        if (Test-Path $fwCmsisV2) {
            $totalChanges += Sync-FolderFiles -SourceDir $fwCmsisV2 -DestDir $prjCmsisV2 -Filter '*' -RemoveStale
        }
        if (Test-Path $prjCmsisV1) {
            Remove-Item -Path $prjCmsisV1 -Recurse -Force
            Write-Host "  [CLEANED] Removed CMSIS V1 folder (Source\CMSIS_RTOS)" -ForegroundColor Yellow
            $totalChanges++
        }
        if ($needDriversRtos2 -and (Test-Path $cprojectPath) -and (Test-Path $prjRtos2Inc)) {
            $cpContent = Get-Content -Path $cprojectPath -Raw
            $anchor = '<listOptionValue builtIn="false" value="../Drivers/CMSIS/Include"/>'
            if ($cpContent -notmatch [regex]::Escape('../Drivers/CMSIS/RTOS2/Include')) {
                $insertion = $anchor + "`r`n`t`t`t`t`t`t`t`t`t" + '<listOptionValue builtIn="false" value="../Drivers/CMSIS/RTOS2/Include"/>'
                $cpContent = $cpContent.Replace($anchor, $insertion)
                Set-Content -Path $cprojectPath -Value $cpContent -NoNewline
                Write-Host "  [CPROJECT] Added ../Drivers/CMSIS/RTOS2/Include to include paths" -ForegroundColor Green
                $totalChanges++
            }
        }
    } elseif ($rtosInterface -eq 'CMSIS_V1') {
        Write-Host "Syncing CMSIS_V1: Middlewares\...\CMSIS_RTOS only" -ForegroundColor Cyan
        if (Test-Path $fwCmsisV1) {
            $totalChanges += Sync-FolderFiles -SourceDir $fwCmsisV1 -DestDir $prjCmsisV1 -Filter '*' -RemoveStale
        } else {
            $errMsg = "CMSIS-RTOS V1 is selected in STM32CubeMX, but the current Firmware Package (CMSIS V6 / FreeRTOS V11) does not support CMSIS-RTOS V1 (missing 'Source\CMSIS_RTOS').`r`n`r`nPlease switch the FreeRTOS interface to CMSIS_V2 in STM32CubeMX and regenerate the code."
            Write-Host "  [ERROR] $errMsg" -ForegroundColor Red
            $wshell = New-Object -ComObject WScript.Shell
            [void]$wshell.Popup($errMsg, 8, "STM32CubeMX Post-Generation Error: CMSIS_V1 Not Supported", 16 + 4096)
            exit 1
        }
        if (Test-Path $prjCmsisV2) {
            Remove-Item -Path $prjCmsisV2 -Recurse -Force
            Write-Host "  [CLEANED] Removed CMSIS_RTOS_V2 folder" -ForegroundColor Yellow
            $totalChanges++
        }
        if (Test-Path $prjRtos2Dir) {
            Remove-Item -Path $prjRtos2Dir -Recurse -Force
            Write-Host "  [CLEANED] Removed Drivers\CMSIS\RTOS2 folder" -ForegroundColor Yellow
            $totalChanges++
        }
    } else {
        Write-Host "FreeRTOS Native mode: Removing CMSIS_RTOS_V1/V2 wrappers if present" -ForegroundColor Cyan
        if (Test-Path $prjCmsisV1) { Remove-Item -Path $prjCmsisV1 -Recurse -Force; $totalChanges++ }
        if (Test-Path $prjCmsisV2) { Remove-Item -Path $prjCmsisV2 -Recurse -Force; $totalChanges++ }
        if (Test-Path $prjRtos2Dir) { Remove-Item -Path $prjRtos2Dir -Recurse -Force; $totalChanges++ }
    }

    # 5c. Ensure Core/Inc/FreeRTOSConfig.h has required defines for FreeRTOS V11 / new CMSIS-RTOS2
    $frConfigPath = Join-Path $projectDir 'Core\Inc\FreeRTOSConfig.h'
    $fwFreertosOs2H = Join-Path $fwCmsisV2 'freertos_os2.h'
    if ((Test-Path $frConfigPath) -and (Test-Path $fwFreertosOs2H) -and ($rtosInterface -eq 'CMSIS_V2')) {
        $frContent = Get-Content -Path $frConfigPath -Raw
        $requiredDefines = @(
            @{ Name = 'CMSIS_device_header'; Line = '#define CMSIS_device_header "stm32f7xx.h"' },
            @{ Name = 'configKERNEL_PROVIDED_STATIC_MEMORY'; Line = '#define configKERNEL_PROVIDED_STATIC_MEMORY 1' },
            @{ Name = 'USE_CUSTOM_SYSTICK_HANDLER_IMPLEMENTATION'; Line = '#define USE_CUSTOM_SYSTICK_HANDLER_IMPLEMENTATION 1' },
            @{ Name = 'INCLUDE_xTaskGetCurrentTaskHandle'; Line = '#define INCLUDE_xTaskGetCurrentTaskHandle 1' },
            @{ Name = 'INCLUDE_xTaskAbortDelay'; Line = '#define INCLUDE_xTaskAbortDelay 1' }
        )

        $linesToInject = @()
        foreach ($def in $requiredDefines) {
            if ($frContent -notmatch "\b$($def.Name)\b") {
                $linesToInject += $def.Line
            }
        }

        if ($linesToInject.Count -gt 0) {
            $userDefinesMarker = '/* USER CODE BEGIN Defines */'
            if ($frContent.Contains($userDefinesMarker)) {
                $injectBlock = $userDefinesMarker + "`r`n" + ($linesToInject -join "`r`n")
                $frContent = $frContent.Replace($userDefinesMarker, $injectBlock)
                Set-Content -Path $frConfigPath -Value $frContent -NoNewline
                Write-Host "  [CONFIG] Added FreeRTOS V11/CMSIS-RTOS2 defines to FreeRTOSConfig.h" -ForegroundColor Green
                $totalChanges++
            }
        }
    }
}

if ($totalChanges -eq 0) {
    Write-Host "All folders and configs are already identical. No files copied." -ForegroundColor Cyan
} else {
    Write-Host "Sync completed successfully ($totalChanges item(s) updated)." -ForegroundColor Green
}
